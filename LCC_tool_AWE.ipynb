    "\n",
    "    op_cost_S2_high\n",
    "\n",
    ")\n",
    " \n",
    "print(\"AWE S2 OPEX distribution used for TCO Monte Carlo:\")\n",
    "\n",
    "print(AWE_S2_OPEX_STATS)\n",
