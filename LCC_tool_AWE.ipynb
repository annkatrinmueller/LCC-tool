    "    4,           # water_pump\n",
    "    22,          # rectifier_power_electronics\n",
    "    1,           # control_unit\n",
    "    1            # housing\n",
    "])\n",
    "\n",
    "\n",
    "# =========================================================\n",
    "# Evaluate all samples\n",
    "# =========================================================\n",
    "\n",
    "Y = param_values @ coefficients\n",
    "\n",
    "# =========================================================\n",
    "# Sobol analysis\n",
    "# =========================================================\n",
    "\n",
    "Si = sobol_analyze.analyze(\n",
