    "fig.text(0.12, 0.73, 'Scenario 2', ha='right', va='center', fontsize=12)\n",
    "\n",
    "# Show plot\n",
    "ax1.grid(True)\n",
    "ax2.grid(True)\n",
    "plt.show()\n"
   ]
